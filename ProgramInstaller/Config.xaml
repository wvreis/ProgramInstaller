<Window x:Class="ProgramInstaller.Config"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gerenciar programas"
        Height="780"
        Width="700"
        MinHeight="620"
        MinWidth="540"
        Icon="Assets/icone.ico"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#172033" Padding="20,14">
            <StackPanel>
                <TextBlock Text="Gerenciar programas" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock Text="Ative, edite ou remova itens da sua lista"
                           Margin="0,4,0,0" Foreground="#B9C4D5"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16,12,16,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Sua lista" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="Edite, altere o status ou exclua diretamente."
                               Margin="0,1,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#E8F0FF" CornerRadius="11" Padding="11,5"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="txtResumo" Foreground="{StaticResource PrimaryBrush}"
                               FontWeight="SemiBold" FontSize="11"/>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <ListBox x:Name="lstProgramas"
                         Style="{StaticResource CardList}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource CardListItem}">
                            <Setter Property="Margin" Value="0,0,0,6"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="38" Height="38" CornerRadius="10" Background="#E8F0FF"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="↓" FontSize="20" FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Nome}" FontSize="14" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border CornerRadius="8" Padding="7,1" Margin="7,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource SuccessSurfaceBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Ativo}" Value="False">
                                                            <Setter Property="Background" Value="{StaticResource InactiveSurfaceBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="10" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Ativo"/>
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Ativo}" Value="False">
                                                                <Setter Property="Text" Value="Inativo"/>
                                                                <Setter Property="Foreground" Value="{StaticResource InactiveBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        </StackPanel>
                                        <TextBlock Margin="0,3,0,0" FontSize="11"
                                                   Foreground="{StaticResource MutedTextBrush}">
                                            <Run Text="{Binding Caminho}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Arquiteturas, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                                Margin="12,0,0,0">
                                        <Button Content="Editar" Style="{StaticResource SecondaryButton}"
                                                MinHeight="32" Padding="10,3" FontSize="11"
                                                Click="btnEditarLinha_Click"/>

                                        <Button MinHeight="32" Padding="10,3" FontSize="11" Margin="6,0"
                                                Click="btnAlternarStatus_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                    <Setter Property="Content" Value="Ativar"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Ativo}" Value="True">
                                                            <Setter Property="Content" Value="Desativar"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Content="Excluir" Style="{StaticResource DangerButton}"
                                                MinHeight="32" Padding="10,3" FontSize="11"
                                                Click="btnExcluirLinha_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border x:Name="emptyState" Background="White" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="12" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Margin="30">
                        <TextBlock Text="＋" FontSize="38" Foreground="{StaticResource PrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Nenhum programa ainda" FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock Text="Adicione o primeiro item e ele aparecerá aqui como um cartão."
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="16,10">
            <Button Content="＋  Adicionar programa" Style="{StaticResource PrimaryButton}"
                    MinHeight="44" HorizontalAlignment="Stretch" Click="btnNovo_Click"/>
        </Border>
    </Grid>
</Window>
