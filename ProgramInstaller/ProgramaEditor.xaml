<Window x:Class="ProgramInstaller.ProgramaEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Programa"
        Height="680"
        Width="580"
        MinHeight="580"
        MinWidth="500"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Icon="Assets/icone.ico"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#172033" Padding="20,14">
            <StackPanel>
                <TextBlock x:Name="txtTitle" Text="Adicionar programa" FontSize="22"
                           FontWeight="SemiBold" Foreground="White"/>
                <TextBlock x:Name="txtSubtitle" Text="Preencha somente o necessário"
                           Margin="0,4,0,0" Foreground="#B9C4D5"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,12">
                <TextBlock Text="Como o programa se chama?" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtNome" Height="40" Padding="10,5" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Qual comando deve ser executado?" FontSize="14"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Buscar no WinGet" Style="{StaticResource SecondaryButton}"
                                MinHeight="30" Padding="9,3" FontSize="11"
                                Click="btnBuscarWinget_Click"/>
                    </StackPanel>
                </Grid>
                <TextBox x:Name="txtCaminho" Height="40" Padding="10,5" Margin="0,0,0,3"
                         ToolTip="Ex.: winget ou C:\Instaladores\setup.exe"/>
                <TextBlock Text="Exemplo: winget ou C:\Instaladores\setup.exe"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,0,0,12"/>

                <TextBlock Text="Precisa de argumentos?" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtArgumentos" Height="54" Padding="10,5" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Margin="0,0,0,3"/>
                <TextBlock Text="Opcional. Deixe em branco quando não souber."
                           Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,0,0,12"/>

                <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Em quais computadores ele funciona?" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="Você pode marcar as duas opções."
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,2,0,9"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="chk64bits" Content="64 bits"
                                      Style="{StaticResource ToggleSwitch}"/>
                            <CheckBox x:Name="chk32bits" Grid.Column="2" Content="32 bits"
                                      Style="{StaticResource ToggleSwitch}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="chkAtivo" Content="Incluir na instalação em lote"
                                  Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Pode ser executado individualmente mesmo quando desativado."
                                   Margin="14,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="1.6*"/>
                </Grid.ColumnDefinitions>
                <Button Content="Cancelar" Style="{StaticResource SecondaryButton}"
                        MinHeight="44" IsCancel="True"/>
                <Button Grid.Column="2" Content="✓  Salvar programa"
                        Style="{StaticResource PrimaryButton}" MinHeight="44"
                        IsDefault="True" Click="btnSalvar_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
