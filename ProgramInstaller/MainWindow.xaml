<Window x:Class="ProgramInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProgramInstaller"
        Height="820"
        Width="720"
        MinHeight="680"
        MinWidth="560"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/icone.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#172033" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Instalar programas" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="Escolha e acompanhe cada instalação"
                               Margin="0,4,0,0" Foreground="#B9C4D5" FontSize="13"/>
                </StackPanel>

                <Button x:Name="btnConfig" Grid.Column="1"
                        Content="⚙  Gerenciar"
                        Style="{StaticResource DarkButton}"
                        MinHeight="38" FontSize="13"
                        Click="btnConfig_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16,12,16,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="12">
                <StackPanel>
                    <TextBlock Text="Qual arquitetura deseja instalar?" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="Normalmente, computadores atuais usam 64 bits."
                               Margin="0,2,0,8" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="opt64bits" Content="64 bits · recomendado"
                                     GroupName="Arquitetura" Style="{StaticResource ChoiceRadioButton}"
                                     MinHeight="38" Padding="12,5"/>
                        <RadioButton x:Name="opt32bits" Grid.Column="2" Content="32 bits"
                                     GroupName="Arquitetura" Style="{StaticResource ChoiceRadioButton}"
                                     MinHeight="38" Padding="12,5"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Seus programas" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="Execute um item ou instale todos no final."
                               Margin="0,1,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource SuccessSurfaceBrush}" CornerRadius="10" Padding="8,3" Margin="0,0,5,0">
                        <TextBlock x:Name="txtAtivos" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" FontSize="11"/>
                    </Border>
                    <Border Background="{StaticResource InactiveSurfaceBrush}" CornerRadius="10" Padding="8,3">
                        <TextBlock x:Name="txtInativos" Foreground="{StaticResource InactiveBrush}" FontWeight="SemiBold" FontSize="11"/>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="4">
                <ListBox x:Name="dtProgramas"
                         Style="{StaticResource CardList}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource CardListItem}">
                            <Setter Property="Margin" Value="0,0,0,6"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="38" Height="38" CornerRadius="10" Background="#E8F0FF">
                                        <TextBlock Text="↓" FontSize="20" FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Nome}" FontSize="14" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border CornerRadius="8" Padding="7,1" Margin="7,0,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource SuccessSurfaceBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Ativo}" Value="False">
                                                                <Setter Property="Background" Value="{StaticResource InactiveSurfaceBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="10" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Ativo"/>
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Ativo}" Value="False">
                                                                    <Setter Property="Text" Value="Inativo"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource InactiveBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Margin="0,3,0,0" FontSize="11"
                                                   Foreground="{StaticResource MutedTextBrush}">
                                            <Run Text="{Binding Arquiteturas, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding StatusExecucao, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <Button Grid.Column="3" Content="Executar agora"
                                            Padding="10,4" MinHeight="34" Margin="10,0,0,0"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="btnExecutarLinha_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border x:Name="emptyMain" Background="White" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="12" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Margin="30">
                        <TextBlock Text="↓" FontSize="40" Foreground="{StaticResource PrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Sua lista está vazia" FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock Text="Cadastre os programas que deseja instalar neste computador."
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,16"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                        <Button Content="＋  Cadastrar programa" Style="{StaticResource PrimaryButton}"
                                Click="btnConfig_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="6" Background="#172033" CornerRadius="10" Padding="12,8">
                <Expander Foreground="White">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="txtStatusGeral" Text="Pronto para executar" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="Ver detalhes" Foreground="#B9C4D5" Margin="16,0,0,0"/>
                        </Grid>
                    </Expander.Header>
                    <Grid Margin="0,10,0,0">
                        <TextBox x:Name="txtProgresso" Height="105"
                                 Background="#111827" Foreground="#A7F3D0" BorderBrush="#334155"
                                 FontFamily="Consolas" FontSize="11" IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                        <Button x:Name="btnLimparLog" Content="Limpar" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Style="{StaticResource DarkButton}" Margin="0,6,6,0"
                                Click="btnLimparLog_Click"/>
                    </Grid>
                </Expander>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="16,10">
            <Button x:Name="btnInstalar" Content="▶  Instalar todos os programas ativos"
                    Style="{StaticResource PrimaryButton}" MinHeight="44"
                    HorizontalAlignment="Stretch" Click="btnInstalar_Click"/>
        </Border>
    </Grid>
</Window>
